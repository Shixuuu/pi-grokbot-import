#!/bin/sh
# Fake crontab for sandbox tests: stores the table in $SANDBOX_CRONTAB_FILE.
f="${SANDBOX_CRONTAB_FILE:?SANDBOX_CRONTAB_FILE not set}"
case "$1" in
  -l) if [ -f "$f" ]; then cat "$f"; else echo "no crontab for sandbox" >&2; exit 1; fi ;;
  -) cat > "$f" ;;
  -r) rm -f "$f" ;;
  *) echo "fake crontab: unsupported $*" >&2; exit 2 ;;
esac
